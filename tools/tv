#!/bin/bash
# Wrapper: tools/tv shell '<cmd>' | push | pull | screencap | key
# Creates the Python venv on first use.
DIR="$(cd "$(dirname "$0")/.." && pwd)"
if [ ! -x "$DIR/.venv/bin/python" ]; then
  echo "Creating .venv (first run)..." >&2
  python3 -m venv "$DIR/.venv" && "$DIR/.venv/bin/pip" install -q -r "$DIR/requirements.txt" >&2 || exit 1
fi
exec "$DIR/.venv/bin/python" "$DIR/tools/adb.py" "$@"
